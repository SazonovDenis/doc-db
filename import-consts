#!/usr/bin/env python3
"""
import-consts - константы Java-классов в db-consts.yaml

    import-consts [--root DIR] [--doc DIR] [--src DIR ...] [-o FILE]

Какие классы нужны - берётся из constants_from в db-desc.yaml (у таблиц и колонок); файлы .tsv оттуда gen-html
читает сам. Каждый класс ищется по FQN в
каталогах исходников: по умолчанию */src/main/java модулей проекта (--root, по умолчанию текущий каталог), или --src.
Из класса берутся public static final константы с комментарием перед ними (/** ... */ или //).

Файл генерируется, руками не правится; gen-html берёт константы только из него.
"""
import argparse
import re
import sys
from pathlib import Path

import yaml

PROJECT_ROOT = Path.cwd()  # корень проекта: запуск из него или --root
DATA_DIR = Path("doc") / "db"  # документация БД: yaml-файлы, от корня проекта или --doc


def wanted_classes(doc):
    """FQN из constants_from в порядке появления в db-desc.yaml."""
    out = []
    for tdoc in (doc.get("tables") or {}).values():
        tdoc = tdoc or {}
        fqns = [tdoc.get("constants_from")]
        fqns += [c.get("constants_from") for c in (tdoc.get("columns") or {}).values() if isinstance(c, dict)]
        out += [f for f in fqns if f and not f.endswith(".tsv") and f not in out]
    return out


def find_class(fqn, src_dirs):
    rel_path = fqn.replace(".", "/") + ".java"
    for src_dir in src_dirs:
        candidate = src_dir / rel_path
        if candidate.exists():
            return candidate
    return None


def parse_java_constants(path):
    """Константы Java-класса: list of {name, value, description}."""
    lines = path.read_text(encoding="utf-8").split("\n")
    constants = []
    current_comment = []
    in_block = False

    for line in lines:
        s = line.strip()
        if in_block:
            if "*/" in s:
                in_block = False
                part = s[:s.index("*/")]
                part = re.sub(r"^\*\s*", "", part).strip()
                if part:
                    current_comment.append(part)
            else:
                part = re.sub(r"^\*\s*", "", s).strip()
                if part and not part.startswith("@"):
                    current_comment.append(part)
            continue

        if s.startswith("/**"):
            in_block = True
            current_comment = []
            if "*/" in s[3:]:
                in_block = False
                m = re.search(r"/\*\*(.*?)\*/", s)
                if m:
                    current_comment = [m.group(1).strip()]
            continue

        if s.startswith("//"):
            current_comment = [s[2:].strip()]
            continue

        m = re.match(r"public\s+static\s+final\s+\w+\s+(\w+)\s*=\s*(.+?)\s*;", s)
        if m:
            constants.append({
                "name": m.group(1),
                "value": m.group(2).strip(),
                "description": " ".join(current_comment),
            })
            current_comment = []
        elif s and not s.startswith("*") and not s.startswith("//") and not s.startswith("@"):
            current_comment = []

    return constants


def rel(path):
    try:
        return str(path.resolve().relative_to(PROJECT_ROOT))
    except ValueError:
        return str(path)


def flow(v):
    text = yaml.safe_dump(v, default_flow_style=True, allow_unicode=True, width=10 ** 6, sort_keys=False).strip()
    # у простой строки safe_dump дописывает маркер конца документа «...»
    return text[:-3].strip() if text.endswith("\n...") else text


def write_yaml(classes, src_dirs, out):
    lines = [
        "# Java class constants from constants_from in db-desc.yaml. Generated by import-consts, do not edit by hand.",
        f"source: {flow([rel(d) for d in src_dirs])}",
        "",
        "classes:" + (" {}" if not classes else ""),
    ]
    for fqn, info in classes.items():
        lines.append("")
        lines.append(f"  {fqn}:")
        lines.append(f"    file: {flow(info['file'])}")
        lines.append("    constants:")
        for c in info["constants"]:
            lines.append(f"      - {flow(c)}")
    Path(out).write_text("\n".join(lines) + "\n", encoding="utf-8")


def main():
    ap = argparse.ArgumentParser(description="Java class constants from constants_from -> db-consts.yaml")
    ap.add_argument("--src", nargs="+", metavar="DIR", help="Java source directories (default: */src/main/java)")
    ap.add_argument("--root", type=Path, help="project root (default: current directory)")
    ap.add_argument("--doc", type=Path, help="directory of db-desc.yaml and db-consts.yaml (default: doc/db)")
    ap.add_argument("-o", "--out", help="output file (default: <doc>/db-consts.yaml)")
    a = ap.parse_args()

    global PROJECT_ROOT
    if a.root:
        PROJECT_ROOT = a.root.resolve()
    data_dir = a.doc or PROJECT_ROOT / DATA_DIR
    DOC_FILE = data_dir / "db-desc.yaml"
    a.out = a.out or str(data_dir / "db-consts.yaml")

    if not DOC_FILE.exists():
        sys.exit(f"File not found: {DOC_FILE.name}")
    with open(DOC_FILE, encoding="utf-8") as f:
        doc = yaml.safe_load(f) or {}

    src_dirs = [Path(d) for d in a.src] if a.src else sorted(PROJECT_ROOT.glob("*/src/main/java"))
    classes, failed = {}, False
    for fqn in wanted_classes(doc):
        path = find_class(fqn, src_dirs)
        if path is None:
            print(f"ERROR {fqn}: class not found in {', '.join(rel(d) for d in src_dirs) or '(no directories)'}",
                  file=sys.stderr)
            failed = True
            continue
        consts = parse_java_constants(path)
        if not consts:
            print(f"WARN {fqn}: no public static final constants in {rel(path)}", file=sys.stderr)
        classes[fqn] = {"file": rel(path), "constants": consts}

    write_yaml(classes, src_dirs, a.out)
    print(f"{a.out}: classes {len(classes)}, constants {sum(len(c['constants']) for c in classes.values())}")
    if failed:
        sys.exit(1)


if __name__ == "__main__":
    main()
