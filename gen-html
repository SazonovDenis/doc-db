# PlantUML - только свой, в lib утилиты
PLANTUML_JAR = SCRIPT_DIR / "lib" / "plantuml.jar"

# Ключи, которые может содержать db-desc.yaml; всё остальное - опечатка или устаревшее
DOC_KEYS = {"title", "subtitle", "diagrams", "tables"}
DIAGRAM_KEYS = {"title", "description", "tables", "hide_fields", "top", "bottom"}
# таблица в списке диаграммы - имя или {имя: {...}} с этими ключами
DIAGRAM_TABLE_KEYS = {"hide_references"}
TABLE_KEYS = {"title", "description", "columns", "constants_from"}
COLUMN_KEYS = {"title", "description", "constants_from"}


# ---------------------------------------------------------------------------
# Загрузка
# ---------------------------------------------------------------------------

def load_yaml(path, hint):
    if not path.exists():
        sys.exit(f"File not found: {path.name}: {hint}")
    with open(path, encoding="utf-8") as f:
        return yaml.safe_load(f) or {}


def load_struct():
    """
    Returns dict: table_name -> {
      columns: {col_name -> {type, required, references, values}},   # в физическом порядке
      pk:      [col_name, ...],
    }
    """
    raw = load_yaml(STRUCT_FILE, "generate it with import-struct first")
    schema = {}
    for tname, t in (raw.get("tables") or {}).items():
        t = t or {}
        schema[tname] = {"columns": dict(t.get("columns") or {}), "pk": list(t.get("primary_key") or [])}
    return schema


def build_all_refs(schema):
    """table_name -> {col -> ref_table}: ссылки (FK) из структуры."""
    return {tname: {c: info["references"] for c, info in t["columns"].items() if (info or {}).get("references")}
            for tname, t in schema.items()}


# ---------------------------------------------------------------------------
# Проверка db-desc.yaml: ничего лишнего
# ---------------------------------------------------------------------------

def check_doc(schema, doc, strict=False):
    """Лишнее в db-desc.yaml - ошибка; неописанное - счётчик, а при strict - тоже ошибка со списком."""
    errors = []
    missing = []

    def keys(where, d, allowed):
        if not isinstance(d, dict):
            errors.append(f"  [bad value]      {where}: mapping expected")
            return False
        for k in sorted(set(d) - allowed):
            errors.append(f"  [unknown key]    {where}: {k}")
        return True

    def dups(where, items):
        seen = set()
        for x in items:
            if x in seen:
                errors.append(f"  [duplicate]      {where}: {x}")
            seen.add(x)

    keys("<file>", doc, DOC_KEYS)

    for gname, g in (doc.get("diagrams") or {}).items():
        where = f"diagrams.{gname}"
        if not keys(where, g, DIAGRAM_KEYS):
            continue
        gtables = []
        for entry in g.get("tables") or []:
            if isinstance(entry, dict):
                if len(entry) != 1:
                    errors.append(f"  [bad value]      {where}: {entry}  (one table per list item expected)")
                    continue
                t, opts = next(iter(entry.items()))
                if not keys(f"{where}.{t}", opts or {}, DIAGRAM_TABLE_KEYS):
                    continue
            else:
                t, opts = entry, {}
            if t not in schema:
                errors.append(f"  [extra table]    {where}: {t}  (not in schema)")
                continue
            gtables.append(t)
            dups(f"{where}.{t}.hide_references", (opts or {}).get("hide_references") or [])
            for c in (opts or {}).get("hide_references") or []:
                if c not in schema[t]["columns"]:
                    errors.append(f"  [extra column]   {where}.{t}.hide_references: {c}  (not in schema)")
        dups(f"{where}.tables", gtables)
        for key in ("hide_fields", "top", "bottom"):
            dups(f"{where}.{key}", g.get(key) or [])
            for t in g.get(key) or []:
                if t not in gtables:
                    errors.append(f"  [extra table]    {where}.{key}: {t}  (not in diagram tables)")
        for t in sorted(set(g.get("top") or []) & set(g.get("bottom") or [])):
            errors.append(f"  [bad value]      {where}: {t}  (both in top and bottom)")

    undocumented = 0
    tables_doc = doc.get("tables") or {}
    for tname, tdoc in tables_doc.items():
        if tname not in schema:
            errors.append(f"  [extra table]    {tname}  (not in schema)")
            continue
        tdoc = tdoc or {}
        if not keys(tname, tdoc, TABLE_KEYS):
            continue
        cols = tdoc.get("columns") or {}
        for cname, cdoc in cols.items():
            if cname not in schema[tname]["columns"]:
                errors.append(f"  [extra column]   {tname}.{cname}  (not in schema)")
            elif cdoc is not None and not isinstance(cdoc, str):
                keys(f"{tname}.{cname}", cdoc, COLUMN_KEYS)
        undoc_cols = [c for c in schema[tname]["columns"] if c not in cols and c not in schema[tname]["pk"]]
        undocumented += len(undoc_cols)
        missing += [f"  [missing column] {tname}.{c}" for c in undoc_cols]
    for t in sorted(set(schema) - set(tables_doc)):
        undocumented += len([c for c in schema[t]["columns"] if c not in schema[t]["pk"]])
        missing.append(f"  [missing table]  {t}")
    if strict:
        errors += missing

    if errors:
        print("ERRORS in db-desc.yaml:")
        print("\n".join(errors))
        sys.exit(1)
    missing_tables = len(set(schema) - set(tables_doc))
    if missing_tables or undocumented:
        print(f"Undocumented: tables {missing_tables}, columns {undocumented}")


def normalize_doc(doc):
    """
    Колонку можно описать строкой вместо {description: ...}. Таблицы диаграммы - список имён и {имя: {...}},
    становятся словарём {имя -> {...}}: in в шаблоне работает как со списком.
    """
    for ginfo in (doc.get("diagrams") or {}).values():
        tables = {}
        for entry in ginfo.get("tables") or []:
            tname, opts = next(iter(entry.items())) if isinstance(entry, dict) else (entry, None)
            tables[tname] = opts or {}
        ginfo["tables"] = tables
    for tdoc in (doc.get("tables") or {}).values():
        for cname, cdoc in list(((tdoc or {}).get("columns") or {}).items()):
            if isinstance(cdoc, str):
                tdoc["columns"][cname] = {"description": cdoc}
    return doc



# ---------------------------------------------------------------------------
# Константы Java-классов (db-consts.yaml)
# ---------------------------------------------------------------------------

def is_tsv(source):
    return source.endswith(".tsv")


# заголовки колонок .tsv (первая строка) -> поле константы
TSV_HEADERS = {
    "name": ("код", "code"),
    "value": ("значение", "text", "name"),
    "description": ("пояснение", "description"),
}


def load_tsv(path):
    """Строки .tsv без заголовка: [{name, value, description}]. Колонки ищутся по заголовкам первой строки
    (TSV_HEADERS, порядок любой, лишние колонки - например, id - пропускаются); нет ни одного известного
    заголовка - первые три колонки по порядку."""
    lines = path.read_text(encoding="utf-8").splitlines()
    if not lines:
        return []
    header = [h.strip().lower() for h in lines[0].split("\t")]
    index = {field: next((header.index(h) for h in names if h in header), None)
             for field, names in TSV_HEADERS.items()}
    if all(i is None for i in index.values()):
        index = {"name": 0, "value": 1, "description": 2}
    rows = []
    for line in lines[1:]:
        if not line.strip():
            continue
        cells = line.split("\t")
        rows.append({field: cells[i] if i is not None and i < len(cells) else ""
                     for field, i in index.items()})
    return rows


def load_consts(doc):
    """
    {source -> [{name, value, description}]}: source - FQN или путь к .tsv из constants_from.
    Классы - из db-consts.yaml, он нужен, только если в constants_from есть классы; класса нет в файле -
    ошибка: db-consts.yaml устарел. Файла .tsv нет - ошибка.
    """
    used = []
    for tname, tdoc in (doc.get("tables") or {}).items():
        tdoc = tdoc or {}
        if tdoc.get("constants_from"):
            used.append((tname, tdoc["constants_from"]))
        for cname, cdoc in (tdoc.get("columns") or {}).items():
            if isinstance(cdoc, dict) and cdoc.get("constants_from"):
                used.append((f"{tname}.{cname}", cdoc["constants_from"]))
    consts = {}
    missing_tsv = []
    for where, source in used:
        if is_tsv(source) and source not in consts:
            path = PROJECT_ROOT / source
            if path.exists():
                consts[source] = load_tsv(path)
            else:
                missing_tsv.append(f"  [no file]        {where}: {source}")
    if missing_tsv:
        print("ERRORS: .tsv files from constants_from not found (paths are relative to the project root):")
        print("\n".join(missing_tsv))
        sys.exit(1)

    classes = [(where, source) for where, source in used if not is_tsv(source)]
    if not classes:
        return consts

    raw = load_yaml(CONSTS_FILE, "db-desc.yaml has constants_from - generate it with import-consts")
    java = {fqn: (info or {}).get("constants") or [] for fqn, info in (raw.get("classes") or {}).items()}
    missing = [f"  [no constants]   {where}: {fqn}" for where, fqn in classes if fqn not in java]
    if missing:
        print("ERRORS: classes missing from db-consts.yaml (regenerate it with import-consts):")
        print("\n".join(missing))
        sys.exit(1)
    consts.update(java)
    return consts


def resolve_constants(doc, consts):
    """
    Returns (table_constants, col_constants).
    table_constants: {tname -> [{name, value, description}]}
    col_constants:   {tname -> {colname -> [{name, value, description}]}}
    """
    table_constants = {}
    col_constants = {}
    for tname, tdoc in (doc.get("tables") or {}).items():
        if not tdoc:
            continue
        fqn = tdoc.get("constants_from")
        if fqn and consts.get(fqn):
            table_constants[tname] = consts[fqn]
        for cname, cdoc in (tdoc.get("columns") or {}).items():
            if not isinstance(cdoc, dict):
                continue
            fqn = cdoc.get("constants_from")
            if fqn and consts.get(fqn):
                col_constants.setdefault(tname, {})[cname] = consts[fqn]
    return table_constants, col_constants


# ---------------------------------------------------------------------------
# PlantUML helpers
# ---------------------------------------------------------------------------

def find_plantuml():
    return str(PLANTUML_JAR) if PLANTUML_JAR.exists() else None


def run_plantuml(puml_text):
    """Run plantuml on puml_text, return SVG string or None. Результат кэшируется в PLANTUML_CACHE."""
    cached = PLANTUML_CACHE / (hashlib.sha1(puml_text.encode("utf-8")).hexdigest() + ".svg")
    used_cache.add(cached.name)
    if cached.exists():
        return cached.read_text(encoding="utf-8")
    jar = find_plantuml()
    if jar is None:
        return None
    svg = _render_plantuml(jar, puml_text)
    if svg:
        PLANTUML_CACHE.mkdir(parents=True, exist_ok=True)
        cached.write_text(svg, encoding="utf-8")
    return svg


def _render_plantuml(jar, puml_text):
    with tempfile.NamedTemporaryFile(suffix=".puml", delete=False, mode="w", encoding="utf-8") as f:
        f.write(puml_text)
        tmp = f.name
    svg_path = tmp.replace(".puml", ".svg")
    try:
        subprocess.run(
            ["java", "-jar", jar, "-tsvg", "-quiet", tmp],
            check=True, capture_output=True
        )
        if os.path.exists(svg_path):
            with open(svg_path, encoding="utf-8") as f:
                svg = f.read()
            # strip XML declaration and DOCTYPE
            svg = re.sub(r"<\?xml[^>]*\?>", "", svg)
            svg = re.sub(r"<!DOCTYPE[^>]*>", "", svg)
            return svg.strip()
    except Exception:
        pass
    finally:
        os.unlink(tmp)
        if os.path.exists(svg_path):
            os.unlink(svg_path)
    return None


PUML_HEADER = """\
@startuml
hide circle
hide empty members
skinparam roundcorner 5
skinparam shadowing false
' ссылки на таблицы - цветом имени таблицы в HTML (--c-head в template.html.j2)
skinparam hyperlinkColor #1a5fa0
skinparam class {
  BackgroundColor white
  ArrowColor #2688d4
  BorderColor #2688d4
}
"""



def _puml_text(text):
    """Одна строка без кавычек и угловых скобок: < > - разметка Creole, " - конец имени класса."""
    line = (text or "").strip().split("\n")[0].strip()
    return line.replace('"', "'").replace("<", "‹").replace(">", "›")


def _puml_class(tname, tables_doc, link=True):
    """
    Заголовок класса: имя таблицы, под ним серым её title из db-desc.yaml. Ссылка - только на имени в заголовке:
    ссылка на классе делает кликабельной всю рамку с полями. link=False - без ссылки, имя цветом ссылок на таблицы
    (центральная таблица схемы связей).
    """
    title = _puml_text((tables_doc.get(tname) or {}).get("title"))
    name = f"<b>[[#tbl_{tname} {tname}]]</b>" if link else f"<b><color:#1a5fa0>{tname}</color></b>"
    label = f"{name}\\n<color:gray>{title}</color>" if title else name
    return f'class "{label}" as {tname} {{'


def _col_title(tdoc, col):
    """title колонки из db-desc.yaml, нет - description."""
    cdoc = (tdoc.get("columns") or {}).get(col) or {}
    return _puml_text(cdoc.get("title") or cdoc.get("description"))


# схема связей: если на центральную таблицу ссылается больше стольких таблиц, они не рисуются по одной,
# а собираются по колонке-ссылке в общую рамку (package) - одна стрелка вместо десятков
REFS_MAX_SINGLE = 6
REFS_PER_LINE = 4  # таблиц в строке внутри рамки
REFS_MAX_FRAMES_WIDE = 3  # рамок больше - таблицы в рамках идут в столбик, иначе не хватает ширины


def _puml_refs_group(gid, col, tnames, tables_doc, focal_table, per_line):
    """
    Пунктирная рамка с таблицами, которые ссылаются на центральную через колонки col: внутри - таблицы, как везде
    (имя ссылкой, под ним title), сеткой по per_line в строке; строки задают невидимые связи сверху вниз.
    Стрелка к центральной идёт от невидимого якоря под нижним рядом - из нижнего края рамки, а не сбоку.
    """
    names = sorted(tnames)
    anchor = f"{gid}_out"
    # <<Rectangle>> - рамка без заголовка-вкладки
    lines = [f'package " " as {gid} <<Rectangle>> #line:gray;line.dashed {{']
    for n in names:
        lines += [_puml_class(n, tables_doc), "}"]
    lines.append(f'class " " as {anchor} #back:transparent;line:transparent {{')
    lines.append("}")
    lines.append("}")
    for i in range(per_line, len(names)):
        lines.append(f"{names[i - per_line]} -[hidden]-> {names[i]}")
    # таблицы без соседа снизу - над якорем
    for i in range(max(0, len(names) - per_line), len(names)):
        lines.append(f"{names[i]} -[hidden]-> {anchor}")
    lines.append(f"{anchor} --> {focal_table} : {col}")
    return lines


def puml_refs_diagram(focal_table, tables, all_refs, tables_doc):
    """Per-table refs diagram: focal + neighbors."""
    incoming = {}  # table -> [col]
    for tname, refs in all_refs.items():
        if tname == focal_table:
            continue
        for col, ref in refs.items():
            if ref == focal_table:
                incoming.setdefault(tname, []).append(col)

    outgoing = all_refs.get(focal_table, {})

    involved = {focal_table} | set(incoming) | set(outgoing.values())
    if len(involved) == 1:
        return None  # isolated table, skip diagram

    grouped = len(incoming) > REFS_MAX_SINGLE
    lines = [PUML_HEADER]
    if grouped:
        # плотная сетка в рамке: отступы по умолчанию рассчитаны на стрелки между таблицами
        lines += ["skinparam nodesep 12", "skinparam ranksep 24"]
    for t in sorted(involved):
        if grouped and t in incoming and t not in outgoing.values():
            continue  # рисуется в рамке группы
        focal = t == focal_table
        lines.append(_puml_class(t, tables_doc, link=not focal))
        lines.append('}')

    if grouped:
        # колонки-ссылки -> таблицы: таблица со ссылкой через несколько колонок - в одной рамке, с их списком
        by_cols = {}
        for t, cols in incoming.items():
            if t in outgoing.values():
                for col in cols:
                    lines.append(f"{t} --> {focal_table} : {col}")  # нарисована отдельно - связи в обе стороны
            else:
                by_cols.setdefault(", ".join(sorted(cols)), []).append(t)
        per_line = 1 if len(by_cols) > REFS_MAX_FRAMES_WIDE else REFS_PER_LINE
        for i, (cols, tnames) in enumerate(sorted(by_cols.items())):
            lines += _puml_refs_group(f"_refs_{i}", cols, tnames, tables_doc, focal_table, per_line)
    else:
        for t, cols in incoming.items():
            for col in cols:
                lines.append(f"{t} --> {focal_table} : {col}")

    for col, ref in outgoing.items():
        if ref in tables:
            lines.append(f"{focal_table} --> {ref} : {col}")

    lines.append("@enduml")
    return "\n".join(lines)


def puml_group_diagram(ginfo, tables, all_refs, column_order, tables_doc):
    """
    Multi-table diagram: show selected tables with their columns and FK arrows.
    ginfo - диаграмма после normalize_doc: hide_fields диаграммы - таблицы, которые рисуются без полей,
    hide_references таблицы - стрелки по этим её колонкам не рисуются.
    top / bottom - подсказка раскладке: стрелки к таблицам top и от таблиц bottom рисуются вверх (-up->),
    и Graphviz ставит такие таблицы выше связанных с ними.
    """
    group_tables = ginfo.get("tables") or {}
    hide_fields = set(ginfo.get("hide_fields") or [])
    top = set(ginfo.get("top") or [])
    bottom = set(ginfo.get("bottom") or [])
    lines = [PUML_HEADER]

    for tname in group_tables:
        if tname not in tables:
            continue
        cols = tables[tname]["columns"]
        tdoc = tables_doc.get(tname) or {}
        lines.append(_puml_class(tname, tables_doc))
        pk = tables[tname]["pk"]
        for col in column_order.get(tname, cols.keys()):
            if col in pk or tname in hide_fields:
                continue  # первичный ключ на диаграмме не показывается
            # {field}: скобки в title не превращают поле в метод (отдельный раздел класса)
            line = f"  {{field}} {col}"
            title = _col_title(tdoc, col)
            if title:
                line += f" <color:gray>{title}</color>"
            lines.append(line)
        lines.append("}")

    for tname, opts in group_tables.items():
        if tname not in tables:
            continue
        refs = all_refs.get(tname, {})
        for col, ref in refs.items():
            if ref in group_tables and col not in (opts.get("hide_references") or []):
                up = (ref in top and tname not in top) or (tname in bottom and ref not in bottom)
                lines.append(f"{tname} -{'up' if up else ''}-> {ref} : {col}")

    lines.append("@enduml")
    return "\n".join(lines)


def order_columns(cols, pk, tdoc, refs):
    """
    Порядок колонок: первичный ключ, затем как перечислены в db-desc.yaml, остальные - ссылки (FK) по алфавиту,
    затем прочие по алфавиту.
    """
    ids = [c for c in pk if c in cols]
    doc_order = [c for c in (tdoc.get("columns") or {}) if c in cols and c not in ids]
    rest = [c for c in cols if c not in ids and c not in doc_order]
    fks = sorted(c for c in rest if c in refs)
    others = sorted(c for c in rest if c not in refs)
    return ids + doc_order + fks + others


# ---------------------------------------------------------------------------
# HTML generation
# ---------------------------------------------------------------------------

def generate_html(schema, all_refs, doc, consts, template_file, output_file, variables):
    tables_doc = doc.get("tables") or {}
    diagrams_doc = doc.get("diagrams") or {}
    table_constants, col_constants = resolve_constants(doc, consts)

    column_order = {}
    for tname in schema:
        tdoc = tables_doc.get(tname) or {}
        column_order[tname] = order_columns(schema[tname]["columns"], schema[tname]["pk"], tdoc, all_refs.get(tname, {}))

    # generate per-table ref diagrams
    table_svgs = {}
    for tname in sorted(schema):
        puml = puml_refs_diagram(tname, schema, all_refs, tables_doc)
        if puml:
            svg = run_plantuml(puml)
            if svg:
                table_svgs[tname] = svg

    # generate group diagrams
    group_svgs = {}
    for gname, ginfo in diagrams_doc.items():
        puml = puml_group_diagram(ginfo, schema, all_refs, column_order, tables_doc)
        if puml:
            svg = run_plantuml(puml)
            if svg:
                group_svgs[gname] = svg

    if PLANTUML_CACHE.exists():
        for f in PLANTUML_CACHE.glob("*.svg"):
            if f.name not in used_cache:
                f.unlink()

    if find_plantuml() is None:
        print(f"PlantUML not found ({PLANTUML_JAR}) - no diagrams")

    # Каталог шаблона, затем SCRIPT_DIR: свой шаблон может расширять template.html.j2
    env = Environment(loader=FileSystemLoader([str(template_file.parent), str(SCRIPT_DIR)]), autoescape=False,
                      trim_blocks=True, lstrip_blocks=True)
    tmpl = env.get_template(template_file.name)

    html = tmpl.render(
        doc=doc,
        schema=schema,
        all_refs=all_refs,
        tables_doc=tables_doc,
        diagrams_doc=diagrams_doc,
        sorted_tables=sorted(schema.keys()),
        table_svgs=table_svgs,
        group_svgs=group_svgs,
        table_constants=table_constants,
        col_constants=col_constants,
        column_order=column_order,
        **variables,
    )
    output_file.parent.mkdir(parents=True, exist_ok=True)
    output_file.write_text(html, encoding="utf-8")
    print(f"Generated: {output_file}")


