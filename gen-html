def load_labels(lang, labels_file):
    """Переменные шаблона для подписей: t - словарь подписей (base, затем язык, затем свой файл), lang - код языка."""
    lang = lang or BASE_LANG
    t = {}
    for path in (LANG_DIR / f"{BASE_LANG}.yaml", LANG_DIR / f"{lang}.yaml", labels_file):
        if path:
            t.update(load_yaml(path, "labels file") or {})
    return {"t": t, "lang": lang}


def parse_var(s):
    name, sep, value = s.partition("=")
    if not sep or not name:
        raise argparse.ArgumentTypeError(f"NAME=VALUE expected: {s}")
    return name, value


def main():
    ap = argparse.ArgumentParser(description="HTML DB documentation from db-struct.yaml, db-desc.yaml and db-consts.yaml")
    langs = sorted(p.stem for p in LANG_DIR.glob("*.yaml"))
    lang = ap.add_mutually_exclusive_group()
    lang.add_argument("--lang", choices=langs, help=f"label language: lang/<lang>.yaml (default: {BASE_LANG})")
    lang.add_argument("-en", dest="lang", action="store_const", const="en", help="English labels, same as --lang en")
    lang.add_argument("-ru", dest="lang", action="store_const", const="ru", help="Russian labels, same as --lang ru")
    ap.add_argument("--labels", type=Path, help="yaml with own labels over the language ones")
    ap.add_argument("-t", "--template", type=Path, default=TEMPLATE_FILE,
                    help="own Jinja template; may extend template.html.j2 (default: template.html.j2)")
    ap.add_argument("-o", "--output", type=Path, help="output file (default: _site/db.html under the project root)")
    ap.add_argument("-D", dest="vars", type=parse_var, action="append", default=[], metavar="NAME=VALUE",
                    help="template variable")
    ap.add_argument("--root", type=Path, help="project root: .tsv paths from constants_from are relative to it (default: current directory)")
    ap.add_argument("--doc", type=Path, help="directory of db-struct.yaml, db-desc.yaml, db-consts.yaml (default: doc/db)")
    ap.add_argument("--strict", action="store_true", help="undocumented tables and columns are errors")
    args = ap.parse_args()

    global PROJECT_ROOT, STRUCT_FILE, YAML_FILE, CONSTS_FILE, PLANTUML_CACHE
    if args.root:
        PROJECT_ROOT = args.root.resolve()
    data_dir = args.doc or PROJECT_ROOT / DATA_DIR
    STRUCT_FILE, YAML_FILE, CONSTS_FILE = (data_dir / f for f in ("db-struct.yaml", "db-desc.yaml", "db-consts.yaml"))
    args.output = args.output or PROJECT_ROOT / OUTPUT_FILE
    PLANTUML_CACHE = PROJECT_ROOT / ".plantuml-cache"

    schema = load_struct()
    doc = load_yaml(YAML_FILE, "create it (may be empty: title and tables)")
    check_doc(schema, doc, args.strict)
    consts = load_consts(doc)
    generate_html(schema, build_all_refs(schema), normalize_doc(doc), consts,
                  args.template.resolve(), args.output.resolve(), load_labels(args.lang, args.labels) | dict(args.vars))


if __name__ == "__main__":
    main()
