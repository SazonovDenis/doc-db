TEMPLATE_FILE = SCRIPT_DIR / "template.html.j2"
# подписи HTML по языкам: lang/<язык>.yaml, базовый - en (недостающие ключи берутся из него)
LANG_DIR = SCRIPT_DIR / "lang"
