<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<title>{{ doc.title | default(t.default_title) }}</title>
<style>
/* Размеры шрифта - пять:
   --fs-1 общий заголовок, --fs-2 заголовки разделов и имя таблицы, --fs-3 подразделы,
   --fs-4 основной текст (описания, флаги, подписи), --fs-5 мелкий - только содержимое констант / .tsv.
   Цвета: --c-main главное, --c-second второстепенное, --c-link ссылки; имя таблицы и разделы - --c-head */
:root {
  --fs-1: 22px; --fs-2: 17px; --fs-3: 15px; --fs-4: 14px; --fs-5: 12px;
  --c-main: #222; --c-second: #777; --c-link: #2688d4; --c-head: #1a5fa0;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: Arial, sans-serif; font-size: var(--fs-4); color: var(--c-main); background: #fff; padding: 24px 32px; }
/* имена файлов и классов - той же гарнитурой, что и текст */
code { font-family: inherit; font-size: 1em; }
a { color: var(--c-link); text-decoration: none; }
a:hover { text-decoration: underline; }
h1 { font-size: var(--fs-1); margin-bottom: 8px; }
h2 { font-size: var(--fs-2); margin: 28px 0 8px; padding-bottom: 4px; border-bottom: 2px solid var(--c-link); color: var(--c-head); }
h3 { font-size: var(--fs-3); margin: 16px 0 6px; color: var(--c-main); }
.subtitle { color: var(--c-second); margin-bottom: 20px; }

/* TOC */
.toc-section { margin-bottom: 6px; }
.toc-section > a { font-weight: bold; color: var(--c-head); }
ul.toc { list-style: none; padding: 0; }
ul.toc li { padding: 2px 0; }
ul.toc li a { color: var(--c-head); }
.toc-desc { color: var(--c-second); margin-left: 8px; }
.toc-flex { display: flex; flex-wrap: wrap; flex-direction: column; max-height: 600px; gap: 2px 24px; list-style: none; padding: 0; margin: 6px 0; }

/* Diagrams */
.diagram-group { margin-bottom: 28px; }
.diagram-wrapper { overflow-x: auto; margin: 4px 0 12px; }
.diagram-wrapper svg { max-width: 100%; height: auto; }
.diagram-missing { color: var(--c-second); }

/* Table section */
.table-section { margin-bottom: 36px; }
.table-header { display: flex; align-items: baseline; gap: 12px; margin: 24px 0 4px; }
.table-header h2 { margin: 0; border: none; }
.table-title { color: var(--c-main); }
.table-desc { color: var(--c-main); font-style: italic; margin-bottom: 6px; line-height: 1.5; white-space: pre-wrap; }
.table-diag-list { color: var(--c-main); margin-bottom: 8px; }
.consts-source { font-weight: normal; color: var(--c-second); margin-left: 8px; }
.col-consts-title { margin-top: 4px; color: var(--c-main); }

/* Fields table */
/* ссылка на таблицу - цветом имени таблицы */
.col-ref-link { font-weight: bold; color: var(--c-head); }
table.fields { border-collapse: collapse; margin-bottom: 12px; font: inherit; max-width: 50rem; }
table.fields th { background: #e8f0fb; color: var(--c-main); text-align: left; padding: 6px 10px; border: 1px solid #c5d5ee; font-weight: normal; }
/* line-height - как у строки со стрелкой ссылки (.col-arrow): все строки одной высоты; отступ снизу меньше -
   под буквами без выносных элементов и так пусто, иначе строка выглядит приподнятой */
table.fields td { padding: 3px 10px 0; border: 1px solid #ddd; vertical-align: top; line-height: 1.6; color: var(--c-main); }
.col-type { white-space: nowrap; }
/* стрелка ссылки крупнее текста, как на диаграммах; line-height - чтобы не раздувала строку;
   top - символ → сидит низко, поднимаем к середине строчных букв */
.col-arrow { font-size: 1.6em; line-height: 1; vertical-align: middle; position: relative; top: -0.2em; }
.col-note { color: var(--c-main); font-style: italic; white-space: pre-line; }
.col-flag { color: var(--c-second); }
.col-values { color: var(--c-second); white-space: normal; max-width: 18rem; }

/* Constants: содержимое - мелким */
table.consts { margin: 6px 0 10px; border-collapse: collapse; font-size: var(--fs-5); max-width: 40rem; }
table.consts th { text-align: left; padding: 3px 8px; border: 1px solid #ddd; font-weight: normal; color: var(--c-main); }
table.consts td { padding: 2px 8px; border: 1px solid #ddd; color: var(--c-main); }
.col-desc table.consts { margin: 2px 0 6px; line-height: 1.4; }

</style>
{% block style %}{% endblock %}
</head>
<body>
{% block page %}
<h1><a id="_top"></a>{{ doc.title | default(t.default_title) }}</h1>
{% if doc.subtitle %}<div class="subtitle">{{ doc.subtitle }}</div>{% endif %}

{% block toc %}
<h2>{{ t.contents }}</h2>
<ul class="toc">
{% if diagrams_doc %}
  <li><a href="#_diagrams"><h3>{{ t.diagrams }}</h3></a>
    <ul class="toc" style="margin-left:16px">
    {% for gname, ginfo in diagrams_doc.items() %}
      <li><a href="#diag_{{ gname }}">{{ ginfo.title | default(gname) }}</a></li>
    {% endfor %}
    </ul>
  </li>
{% endif %}
  <li><a href="#_tables"><h3>{{ t.tables }} ({{ sorted_tables | length }})</h3></a>
    <ul class="toc-flex">
    {% for tname in sorted_tables %}
      <li><a href="#tbl_{{ tname }}">{{ tname }}</a>
        {% set tdoc = tables_doc.get(tname, {}) %}
        {% if tdoc and tdoc.title %}<span class="toc-desc">{{ tdoc.title }}</span>{% endif %}
      </li>
    {% endfor %}
    </ul>
  </li>
</ul>
{% endblock %}

{% block content %}
{% if diagrams_doc %}
<h2><a id="_diagrams"></a>{{ t.diagrams }}</h2>
{% for gname, ginfo in diagrams_doc.items() %}
<div class="diagram-group">
  <h3><a id="diag_{{ gname }}"></a>{{ ginfo.title | default(gname) }}</h3>
  {% if ginfo.description %}<div class="table-desc">{{ ginfo.description }}</div>{% endif %}
  {% if group_svgs.get(gname) %}
  <div class="diagram-wrapper">{{ group_svgs[gname] }}</div>
  {% else %}
  <div class="diagram-missing">[{{ t.diagram_not_generated }}]</div>
  {% endif %}
</div>
{% endfor %}
{% endif %}

<h2><a id="_tables"></a>{{ t.tables }}</h2>
{% for tname in sorted_tables %}
{% set tdoc = tables_doc.get(tname, {}) or {} %}
{% set tcols = schema[tname].columns %}
{% set tcol_order = column_order.get(tname, tcols.keys()) %}
{% set trefs = all_refs.get(tname, {}) %}
<div class="table-section">
  <div class="table-header">
    <h2><a id="tbl_{{ tname }}"></a>{{ tname }}</h2>
    {% if tdoc.title %}<span class="table-title">{{ tdoc.title }}</span>{% endif %}
  </div>
  {% if tdoc.description %}<div class="table-desc">{{ tdoc.description }}</div>{% endif %}
  {% set tbl_diagrams = [] %}
  {% for gname, ginfo in diagrams_doc.items() if tname in (ginfo.tables or []) %}
    {% if tbl_diagrams.append((gname, ginfo)) %}{% endif %}
  {% endfor %}
  {% if tbl_diagrams %}
  <div class="table-diag-list">{{ t.diagrams }}:
    {% for gname, ginfo in tbl_diagrams %}
    <a href="#diag_{{ gname }}">{{ ginfo.title | default(gname) }}</a>{% if not loop.last %}, {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  <table class="fields">
    <tr><th>{{ t.field }}</th><th>{{ t.type }}</th><th>{{ t.description }}</th></tr>
    {% for col in tcol_order %}
    {% set cinfo = tcols[col] or {} %}
    {% set cdoc = (tdoc.get('columns') or {}).get(col) or {} %}
    {% set ref = trefs.get(col) %}
    <tr>
      <td class="col-name">{{ col }}</td>
      <td class="col-type">{{ cinfo.type }}
        {%- if col in schema[tname].pk %} <span class="col-flag">PK</span>{% elif cinfo.required %} <span class="col-flag">not null</span>{% endif %}
        {%- if ref %} <span class="col-arrow">→</span> <a class="col-ref-link" href="#tbl_{{ ref }}">{{ ref }}</a>{% endif %}
        {%- set cvalues = cinfo.get('values') %}
        {%- if cvalues %}<div class="col-values">{{ cvalues | join(', ') }}</div>{% endif %}</td>
      <td class="col-desc">
        {%- if cdoc.title %}<div>{{ cdoc.title }}</div>{% endif %}
        {%- if cdoc.description %}<div class="col-note">{{ cdoc.description }}</div>{% endif %}
        {% set cconsts = col_constants.get(tname, {}).get(col) %}
        {% if cconsts %}
        <div class="col-consts-title">{{ t.constants }} <span class="consts-source">{{ t.source }}: <code>{{ cdoc.constants_from }}</code></span></div>
        <table class="consts">
          {% for cv in cconsts %}
          <tr><td>{{ cv.name }}</td><td>{{ cv.value }}</td><td>{{ cv.description }}</td></tr>
          {% endfor %}
        </table>
        {% endif %}
      </td>
    </tr>
    {% endfor %}
  </table>

  {% if table_constants.get(tname) %}
  <h3>{{ t.predefined }} <span class="consts-source">{{ t.source }}: <code>{{ tdoc.constants_from }}</code></span></h3>
  <table class="consts">
    <tr><th>{{ t.name }}</th><th>{{ t.value }}</th><th>{{ t.description }}</th></tr>
    {% for c in table_constants[tname] %}
    <tr><td>{{ c.name }}</td><td>{{ c.value }}</td><td>{{ c.description }}</td></tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if table_svgs.get(tname) %}
  <h3>{{ t.relationships }}</h3>
  <div class="diagram-wrapper">{{ table_svgs[tname] }}</div>
  {% endif %}
</div>
{% endfor %}
{% endblock %}
{% endblock %}

</body>
</html>
