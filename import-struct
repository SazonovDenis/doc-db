# Liquibase (XML)
# ---------------------------------------------------------------------------

LB_NS = "http://www.liquibase.org/xml/ns/dbchangelog"


def _tag(el):
    return el.tag.split("}")[-1]


class LiquibaseParser:
    """
    Имена в Liquibase без кавычек сверяются без учёта регистра (QUOTE_ONLY_RESERVED_WORDS), но в документации
    остаётся то написание, с которым таблица заведена в createTable.
    """

    def __init__(self, schema):
        self.s = schema
        self.lower = {}

    def find(self, name, where):
        key = self.lower.get((name or "").lower())
        if key is None:
            warn(f"{where}: unknown table {name}")
        return key

    def col(self, tkey, name):
        for c in self.s.tables[tkey]["columns"]:
            if c.lower() == (name or "").lower():
                return c
        return None

    def run(self, master):
        master = Path(master)
        for f in self.includes(master):
            self.changelog(f)

    def includes(self, path, seen=None):
        seen = seen if seen is not None else set()
        root = ET.parse(path).getroot()
        out = []
        for el in root:
            tag = _tag(el)
            if tag == "include":
                p = Path(el.get("file"))
                cand = [path.parent / p, path.parent / p.name, p]
                inc = next((c for c in cand if c.exists()), None)
                if inc is None:
                    warn(f"{path.name}: include not found: {p}")
                elif inc.resolve() not in seen:
                    seen.add(inc.resolve())
                    out.extend(self.includes(inc, seen))
            elif tag == "includeAll":
                d = path.parent / el.get("path")
                for inc in sorted(d.glob("*.xml")):
                    out.extend(self.includes(inc, seen))
            elif tag == "changeSet" and path not in out:
                out.append(path)
        return out

    def changelog(self, path):
        root = ET.parse(path).getroot()
        for cs in root:
            if _tag(cs) != "changeSet":
                continue
            where = f"{path.name} [{cs.get('id')}]"
            for op in cs:
                handler = getattr(self, "op_" + _tag(op), None)
                if handler:
                    handler(op, where)

    def read_column(self, tkey, el):
        t = self.s.tables[tkey]
        name = self.col(tkey, el.get("name")) or el.get("name")
        t["columns"][name] = {"type": norm_type(el.get("type")), "required": False}
        for con in el:
            if _tag(con) != "constraints":
                continue
            if con.get("nullable") == "false":
                t["columns"][name]["required"] = True
            if con.get("primaryKey") == "true":
                t["pk"] = t["pk"] + [name] if t["constraints"].get("__pk_inline") else [name]
                t["constraints"]["__pk_inline"] = {"kind": "pk"}
                t["columns"][name]["required"] = True
            ref = con.get("referencedTableName") or (con.get("references") or "").split("(")[0].strip()
            if ref:
                cname = con.get("foreignKeyName") or f"{tkey}_{name}_fkey"
                t["constraints"][cname] = {"kind": "fk", "column": name, "ref": ref}

    def op_createTable(self, op, where):
        name = op.get("tableName")
        self.s.create(name)
        self.lower[name.lower()] = name
        for col in op:
            if _tag(col) == "column":
                self.read_column(name, col)

    def op_addColumn(self, op, where):
        tkey = self.find(op.get("tableName"), where)
        if tkey:
            for col in op:
                if _tag(col) == "column":
                    self.read_column(tkey, col)

    def op_dropColumn(self, op, where):
        tkey = self.find(op.get("tableName"), where)
        if not tkey:
            return
        names = [op.get("columnName")] + [c.get("name") for c in op if _tag(c) == "column"]
        for n in filter(None, names):
            c = self.col(tkey, n)
            if c is None:
                warn(f"{where}: unknown column {tkey}.{n}")
            else:
                self.s.drop_column(self.s.tables[tkey], c)

    def op_renameColumn(self, op, where):
        tkey = self.find(op.get("tableName"), where)
        if tkey:
            c = self.col(tkey, op.get("oldColumnName"))
            if c is None:
                warn(f"{where}: unknown column {tkey}.{op.get('oldColumnName')}")
            else:
                self.s.rename_column(self.s.tables[tkey], c, op.get("newColumnName"))

    def op_renameTable(self, op, where):
        old = self.find(op.get("oldTableName"), where)
        if old:
            new = op.get("newTableName")
            self.s.rename_table(old, new)
            for t in self.s.tables.values():
                for con in t["constraints"].values():
                    if con["kind"] == "fk" and con["ref"].lower() == old.lower():
                        con["ref"] = new
            del self.lower[old.lower()]
            self.lower[new.lower()] = new

    def op_dropTable(self, op, where):
        tkey = self.find(op.get("tableName"), where)
        if tkey:
            self.s.drop(tkey)
            for t in self.s.tables.values():
                for cname, con in list(t["constraints"].items()):
                    if con["kind"] == "fk" and con["ref"].lower() == tkey.lower():
                        del t["constraints"][cname]
            del self.lower[tkey.lower()]

    def op_modifyDataType(self, op, where):
        tkey = self.find(op.get("tableName"), where)
        if tkey:
            c = self.col(tkey, op.get("columnName"))
            if c is None:
                warn(f"{where}: unknown column {tkey}.{op.get('columnName')}")
            else:
                self.s.tables[tkey]["columns"][c]["type"] = norm_type(op.get("newDataType"))

    def _nullable(self, op, where, required):
        tkey = self.find(op.get("tableName"), where)
        if tkey:
            c = self.col(tkey, op.get("columnName"))
            if c is not None:
                self.s.tables[tkey]["columns"][c]["required"] = required

    def op_addNotNullConstraint(self, op, where):
        self._nullable(op, where, True)

    def op_dropNotNullConstraint(self, op, where):
        self._nullable(op, where, False)

    def op_addPrimaryKey(self, op, where):
        tkey = self.find(op.get("tableName"), where)
        if tkey:
            t = self.s.tables[tkey]
            t["pk"] = [self.col(tkey, c.strip()) or c.strip() for c in op.get("columnNames", "").split(",")]
            for c in t["pk"]:
                if c in t["columns"]:
                    t["columns"][c]["required"] = True

    def op_dropPrimaryKey(self, op, where):
        tkey = self.find(op.get("tableName"), where)
        if tkey:
            self.s.tables[tkey]["pk"] = []

    def op_addForeignKeyConstraint(self, op, where):
        tkey = self.find(op.get("baseTableName"), where)
        cols = [c.strip() for c in (op.get("baseColumnNames") or "").split(",")]
        if not tkey or len(cols) != 1:
            return
        col = self.col(tkey, cols[0]) or cols[0]
        name = op.get("constraintName") or f"{tkey}_{col}_fkey"
        self.s.tables[tkey]["constraints"][name] = {"kind": "fk", "column": col, "ref": op.get("referencedTableName")}

    def op_dropForeignKeyConstraint(self, op, where):
        tkey = self.find(op.get("baseTableName"), where)
        if tkey and self.s.tables[tkey]["constraints"].pop(op.get("constraintName"), None) is None:
            warn(f"{where}: unknown FK {op.get('constraintName')}")

    def finish(self):
        # FK может ссылаться на таблицу, созданную позже, - имя приводим к каноническому в конце
        for tname, t in self.s.tables.items():
            t["constraints"].pop("__pk_inline", None)
            for con in t["constraints"].values():
                if con["kind"] == "fk":
                    key = self.lower.get(con["ref"].lower())
                    if key is None:
                        warn(f"{tname}.{con['column']}: FK to unknown table {con['ref']}")
                    else:
                        con["ref"] = key


# ---------------------------------------------------------------------------
# Живая база (PostgreSQL, через psql)
# ---------------------------------------------------------------------------

def psql(dsn, sql):
    try:
        r = subprocess.run(["psql", "-X", "-A", "-t", "-F", "\t", "-v", "ON_ERROR_STOP=1", "-d", dsn, "-c", sql],
                           capture_output=True, text=True, check=True)
    except FileNotFoundError:
        sys.exit("psql (PostgreSQL client) is required")
    except subprocess.CalledProcessError as e:
        sys.exit(f"psql: {e.stderr.strip()}")
    return [line.split("\t") for line in r.stdout.splitlines() if line]


def read_db(schema, dsn, nsp):
    q = nsp.replace("'", "''")
    for tname, col, ctype, notnull in psql(dsn, f"""
        SELECT c.relname, a.attname, format_type(a.atttypid, a.atttypmod), a.attnotnull
          FROM pg_attribute a
          JOIN pg_class c ON c.oid = a.attrelid
          JOIN pg_namespace n ON n.oid = c.relnamespace
         WHERE n.nspname = '{q}' AND c.relkind IN ('r', 'p') AND a.attnum > 0 AND NOT a.attisdropped
         ORDER BY c.relname, a.attnum"""):
        t = schema.tables.get(tname) or schema.create(tname)
        t["columns"][col] = {"type": norm_type(ctype), "required": notnull == "t"}

    for tname, cname, kind, cols, ref, definition in psql(dsn, f"""
        SELECT c.relname, k.conname, k.contype,
               (SELECT string_agg(a.attname, ',' ORDER BY x.i)
                  FROM unnest(k.conkey) WITH ORDINALITY x(n, i)
                  JOIN pg_attribute a ON a.attrelid = k.conrelid AND a.attnum = x.n),
               coalesce(r.relname, ''), pg_get_constraintdef(k.oid)
          FROM pg_constraint k
          JOIN pg_class c ON c.oid = k.conrelid
          JOIN pg_namespace n ON n.oid = c.relnamespace
          LEFT JOIN pg_class r ON r.oid = k.confrelid
         WHERE n.nspname = '{q}' AND k.contype IN ('p', 'f', 'c')
         ORDER BY c.relname, k.conname"""):
        t = schema.tables.get(tname)
        if t is None:
            continue
        cols = cols.split(",") if cols else []
        if kind == "p":
            t["pk"] = cols
        elif kind == "f" and len(cols) == 1:
            t["constraints"][cname] = {"kind": "fk", "column": cols[0], "ref": ref}
        elif kind == "c" and len(cols) == 1:
            m = re.match(r"(?is)^CHECK\s*\((.*)\)$", definition.strip())
            v = check_values(m.group(1)) if m else None
            if v and v[0] == cols[0]:
                t["constraints"][cname] = {"kind": "values", "column": cols[0], "values": v[1]}


# ---------------------------------------------------------------------------
# Вывод
# ---------------------------------------------------------------------------

def flow(v):
    text = yaml.safe_dump(v, default_flow_style=True, allow_unicode=True, width=10 ** 6, sort_keys=False).strip()
    # у простой строки safe_dump дописывает маркер конца документа «...»
    return text[:-3].strip() if text.endswith("\n...") else text


def write_yaml(data, source, out):
    lines = [
        "# Physical DB structure. Generated by import-struct, do not edit by hand:",
        "# descriptions go to db-desc.yaml; to regenerate, run import-struct with the same source.",
        f"source: {flow(source)}",
        "",
        "tables:",
    ]
    for tname, t in data.items():
        lines.append("")
        lines.append(f"  {tname}:")
        if "primary_key" in t:
            lines.append(f"    primary_key: {flow(t['primary_key'])}")
        lines.append("    columns:")
        for cname, c in t["columns"].items():
            lines.append(f"      {cname}: {flow(c)}")
    Path(out).write_text("\n".join(lines) + "\n", encoding="utf-8")


def main():
    ap = argparse.ArgumentParser(description="Physical DB structure -> db-struct.yaml")
    src = ap.add_mutually_exclusive_group(required=True)
    src.add_argument("--flyway", nargs="+", metavar="DIR", help="directories with Flyway SQL migrations")
    src.add_argument("--liquibase", metavar="MASTER", help="Liquibase master changelog (XML)")
    src.add_argument("--db", metavar="DSN", help="PostgreSQL connection string, e.g. postgresql://user@host/db")
    ap.add_argument("--schema", default="public", help="DB schema for --db (default: public)")
    ap.add_argument("-o", "--out", default=str(DEFAULT_OUT), help="output file")
    a = ap.parse_args()

    schema = Schema()
    if a.flyway:
        FlywayParser(schema).run(a.flyway)
        source = "flyway: " + ", ".join(a.flyway)
    elif a.liquibase:
        p = LiquibaseParser(schema)
        p.run(a.liquibase)
        p.finish()
        source = "liquibase: " + a.liquibase
    else:
        read_db(schema, a.db, a.schema)
        # пароль из строки подключения в файл не попадает
        source = "db: " + re.sub(r"(//[^:/@]+):[^@]*@", r"\1@", a.db) + f" (schema {a.schema})"

    for name in SERVICE_TABLES:
        schema.tables.pop(name, None)
    data = schema.to_yaml_data()
    write_yaml(data, source, a.out)
    print(f"{a.out}: tables {len(data)}, columns {sum(len(t['columns']) for t in data.values())}")


if __name__ == "__main__":
    main()
