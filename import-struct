# Типы: одно написание для всех источников (как у PostgreSQL, но короче)
# ---------------------------------------------------------------------------

_TYPE_ALIASES = {
    "int": "integer", "int4": "integer", "integer": "integer", "serial": "integer", "serial4": "integer",
    "bigint": "bigint", "int8": "bigint", "bigserial": "bigint", "serial8": "bigint",
    "smallint": "smallint", "int2": "smallint", "smallserial": "smallint", "tinyint": "smallint",
    "bool": "boolean", "boolean": "boolean",
    "timestamptz": "timestamptz", "timestamp with time zone": "timestamptz",
    "timestamp": "timestamp", "timestamp without time zone": "timestamp", "datetime": "timestamp",
    "timetz": "timetz", "time with time zone": "timetz", "time": "time", "time without time zone": "time",
    "float": "double precision", "float8": "double precision", "double": "double precision",
    "double precision": "double precision", "float4": "real", "real": "real",
    "clob": "text", "longtext": "text", "text": "text",
    "decimal": "numeric", "numeric": "numeric",
    "character varying": "varchar", "varchar": "varchar", "nvarchar": "varchar", "varchar2": "varchar",
    "character": "char", "char": "char", "bpchar": "char", "nchar": "char",
}


def norm_type(raw):
    t = re.sub(r"\s+", " ", (raw or "").strip().lower())
    array = ""
    while t.endswith("[]"):
        array += "[]"
        t = t[:-2].strip()
    m = re.match(r"^(.*?)\s*\(([^)]*)\)\s*(.*)$", t)
    args = ""
    if m:
        t = (m.group(1) + (" " + m.group(3) if m.group(3) else "")).strip()
        args = "(" + re.sub(r"\s+", "", m.group(2)) + ")"
    t = _TYPE_ALIASES.get(t, t)
    # точность у timestamp(6) и т. п. для документации не важна
    if t in ("timestamptz", "timestamp", "time", "timetz"):
        args = ""
    return t + args + array


# ---------------------------------------------------------------------------
# SQL: разбиение на операторы и разбор DDL (Flyway)
# ---------------------------------------------------------------------------

def split_statements(sql):
    """Операторы по «;» вне строк, комментариев, $$-блоков и скобок. Комментарии выбрасываются."""
    out, buf, i, n, depth = [], [], 0, len(sql), 0
    while i < n:
        ch = sql[i]
        if sql.startswith("--", i):
            j = sql.find("\n", i)
            i = n if j < 0 else j
            continue
        if sql.startswith("/*", i):
            j = sql.find("*/", i + 2)
            i = n if j < 0 else j + 2
            buf.append(" ")
            continue
        if ch in ("'", '"'):
            j = i + 1
            while j < n:
                if sql[j] == ch:
                    if j + 1 < n and sql[j + 1] == ch:
                        j += 2
                        continue
                    break
                j += 1
            buf.append(sql[i:j + 1])
            i = j + 1
            continue
        m = re.match(r"\$[A-Za-z_]*\$", sql[i:])
        if m:
            tag = m.group(0)
            j = sql.find(tag, i + len(tag))
            j = n if j < 0 else j + len(tag)
            buf.append(sql[i:j])
            i = j
            continue
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
        if ch == ";" and depth == 0:
            out.append("".join(buf).strip())
            buf = []
        else:
            buf.append(ch)
        i += 1
    tail = "".join(buf).strip()
    if tail:
        out.append(tail)
    return [s for s in out if s]


def split_top(s, sep=","):
    """Делит по разделителю на верхнем уровне скобок и вне строк."""
    parts, buf, depth, q = [], [], 0, None
    for ch in s:
        if q:
            buf.append(ch)
            if ch == q:
                q = None
            continue
        if ch in ("'", '"'):
            q = ch
        elif ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
        if ch == sep and depth == 0:
            parts.append("".join(buf).strip())
            buf = []
        else:
            buf.append(ch)
    if "".join(buf).strip():
        parts.append("".join(buf).strip())
    return parts


def ident(s):
    s = s.strip()
    if s.startswith('"') and s.endswith('"'):
        return s[1:-1]
    s = s.lower()
    return s.split(".")[-1]  # схема в имени таблицы не нужна


def paren_body(s, start):
    """Текст внутри скобок, открывающихся в позиции start, и позиция после закрывающей."""
    depth, q = 0, None
    for j in range(start, len(s)):
        ch = s[j]
        if q:
            if ch == q:
                q = None
            continue
        if ch in ("'", '"'):
            q = ch
        elif ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
            if depth == 0:
                return s[start + 1:j], j + 1
    return s[start + 1:], len(s)


IDENT = r'(?:"[^"]+"|[A-Za-z_][\w$]*)(?:\.(?:"[^"]+"|[A-Za-z_][\w$]*))?'
COL_KEYWORDS = r"\b(NOT|NULL|DEFAULT|PRIMARY|REFERENCES|UNIQUE|CHECK|CONSTRAINT|COLLATE|GENERATED)\b"


def check_values(expr):
    """CHECK (col IN ('A', 'B')) или col = ANY (ARRAY[...]) -> (col, [значения]), иначе None."""
    e = expr.strip()
    while e.startswith("(") and paren_body(e, 0)[1] == len(e):
        e = paren_body(e, 0)[0].strip()
    m = re.match(r"^\(?\s*(" + IDENT + r")\s*\)?(?:::\w+)?\s+IN\s*\((.*)\)$", e, re.I | re.S) \
        or re.match(r"^\(?\s*(" + IDENT + r")\s*\)?(?:::\w+)?\s*=\s*ANY\s*\(.*ARRAY\s*\[(.*)\].*\)$", e, re.I | re.S)
    if not m:
        return None
    items = split_top(m.group(2))
    vals = []
    for it in items:
        # значение бывает в скобках: ('A'::character varying)::text - так PostgreSQL выводит CHECK после восстановления
        lit = re.match(r"^[\s(]*'((?:[^']|'')*)'", it)
        if not lit:
            return None
        vals.append(lit.group(1).replace("''", "'"))
    return ident(m.group(1)), vals


class FlywayParser:

    def __init__(self, schema):
        self.s = schema

    def run(self, dirs):
        files = []
        for d in dirs:
            for p in Path(d).glob("V*__*.sql"):
                ver = p.name[1:p.name.index("__")]
                files.append((tuple(int(x) for x in re.split(r"[._]", ver)), p))
        files.sort()
        if not files:
            sys.exit(f"No V*__*.sql migrations in {', '.join(map(str, dirs))}")
        for _, p in files:
            for st in split_statements(p.read_text(encoding="utf-8")):
                self.statement(st, p.name)

    def statement(self, st, fname):
        flat = re.sub(r"\s+", " ", st)
        m = re.match(r"(?i)CREATE (?:UNLOGGED |TEMP |TEMPORARY )?TABLE (?:IF NOT EXISTS )?(" + IDENT + r")\s*\(", flat)
        if m:
            body, _ = paren_body(flat, m.end() - 1)
            self.create_table(ident(m.group(1)), body, fname)
            return
        m = re.match(r"(?i)ALTER TABLE (?:IF EXISTS )?(?:ONLY )?(" + IDENT + r") (.*)$", flat)
        if m:
            self.alter_table(ident(m.group(1)), m.group(2), fname)
            return
        m = re.match(r"(?i)DROP TABLE (?:IF EXISTS )?(.*?)(?: CASCADE| RESTRICT)?$", flat)
        if m:
            for name in split_top(m.group(1)):
                self.s.drop(ident(name))
            return
        # INSERT, UPDATE, CREATE INDEX, CREATE EXTENSION и прочее структуру таблиц не меняют

    # -- CREATE TABLE ---------------------------------------------------------

    def create_table(self, tname, body, where):
        if tname in self.s.tables:
            warn(f"{where}: table {tname} is created again")
        t = self.s.create(tname)
        for el in split_top(body):
            if re.match(r"(?i)(CONSTRAINT|PRIMARY KEY|UNIQUE|CHECK|FOREIGN KEY|EXCLUDE)\b", el):
                self.table_constraint(t, tname, el, where)
            elif re.match(r"(?i)LIKE\b", el):
                warn(f"{where}: {tname}: LIKE is not supported")
            else:
                self.add_column(t, tname, el, where)

    def add_column(self, t, tname, el, where):
        m = re.match(r"(" + IDENT + r")\s+(.*)$", el, re.S)
        if not m:
            warn(f"{where}: {tname}: cannot parse column '{el}'")
            return
        col, rest = ident(m.group(1)), m.group(2)
        k = re.search(COL_KEYWORDS, rest, re.I)
        ctype, cons = (rest[:k.start()], rest[k.start():]) if k else (rest, "")
        t["columns"][col] = {"type": norm_type(ctype), "required": False}
        self.column_constraints(t, tname, col, cons)

    def column_constraints(self, t, tname, col, cons):
        c = t["columns"][col]
        if re.search(r"(?i)\bNOT NULL\b", cons):
            c["required"] = True
        if re.search(r"(?i)\bPRIMARY KEY\b", cons):
            t["pk"] = [col]
            c["required"] = True
            t["constraints"][f"{tname}_pkey"] = {"kind": "pk"}
        r = re.search(r"(?i)\bREFERENCES\s+(" + IDENT + r")", cons)
        if r:
            t["constraints"][f"{tname}_{col}_fkey"] = {"kind": "fk", "column": col, "ref": ident(r.group(1))}
        ch = re.search(r"(?i)\bCHECK\s*\(", cons)
        if ch:
            expr, _ = paren_body(cons, ch.end() - 1)
            v = check_values(expr)
            if v and v[0] == col:
                t["constraints"][f"{tname}_{col}_check"] = {"kind": "values", "column": col, "values": v[1]}

    def table_constraint(self, t, tname, el, where, name=None):
        m = re.match(r"(?i)CONSTRAINT\s+(" + IDENT + r")\s+(.*)$", el, re.S)
        if m:
            name, el = ident(m.group(1)), m.group(2)
        if re.match(r"(?i)PRIMARY KEY", el):
            body, _ = paren_body(el, el.index("("))
            t["pk"] = [ident(c) for c in split_top(body)]
            for c in t["pk"]:
                if c in t["columns"]:
                    t["columns"][c]["required"] = True
            t["constraints"][name or f"{tname}_pkey"] = {"kind": "pk"}
        elif re.match(r"(?i)FOREIGN KEY", el):
            body, after = paren_body(el, el.index("("))
            cols = [ident(c) for c in split_top(body)]
            r = re.search(r"(?i)REFERENCES\s+(" + IDENT + r")", el[after:])
            if r and len(cols) == 1:
                t["constraints"][name or f"{tname}_{cols[0]}_fkey"] = {
                    "kind": "fk", "column": cols[0], "ref": ident(r.group(1))}
            elif r:
                warn(f"{where}: {tname}: composite FK ({', '.join(cols)}) is not shown")
        elif re.match(r"(?i)CHECK", el):
            expr, _ = paren_body(el, el.index("("))
            v = check_values(expr)
            if v:
                t["constraints"][name or f"{tname}_{v[0]}_check"] = {
                    "kind": "values", "column": v[0], "values": v[1]}
            elif name:
                t["constraints"][name] = {"kind": "other"}
        elif name:
            t["constraints"][name] = {"kind": "other"}

    # -- ALTER TABLE ----------------------------------------------------------

    def alter_table(self, tname, actions, where):
        m = re.match(r"(?i)RENAME TO (" + IDENT + r")$", actions)
        if m:
            if self.s.table(tname, where) is not None:
                self.s.rename_table(tname, ident(m.group(1)))
            return
        t = self.s.table(tname, where)
        if t is None:
            return
        m = re.match(r"(?i)RENAME (?:COLUMN )?(" + IDENT + r") TO (" + IDENT + r")$", actions)
        if m:
            if re.match(r"(?i)RENAME CONSTRAINT", actions):
                return
            old = ident(m.group(1))
            if self.s.column(t, tname, old, where) is not None:
                self.s.rename_column(t, old, ident(m.group(2)))
            return
        for act in split_top(actions):
            self.alter_action(t, tname, act, where)

    def alter_action(self, t, tname, act, where):
        m = re.match(r"(?i)ADD (?:COLUMN )?(?:IF NOT EXISTS )?(?!CONSTRAINT\b|PRIMARY\b|UNIQUE\b|CHECK\b|FOREIGN\b)(.*)$", act)
        if m:
            self.add_column(t, tname, m.group(1), where)
            return
        if re.match(r"(?i)ADD ", act):
            self.table_constraint(t, tname, act[4:].strip(), where)
            return
        m = re.match(r"(?i)DROP (?:COLUMN )?(?:IF EXISTS )?(?!CONSTRAINT\b)(" + IDENT + r")(?: CASCADE| RESTRICT)?$", act)
        if m:
            col = ident(m.group(1))
            if self.s.column(t, tname, col, where) is not None:
                self.s.drop_column(t, col)
            return
        m = re.match(r"(?i)DROP CONSTRAINT (?:IF EXISTS )?(" + IDENT + r")", act)
        if m:
            con = t["constraints"].pop(ident(m.group(1)), None)
            if con and con["kind"] == "pk":
                t["pk"] = []
            return
        m = re.match(r"(?i)ALTER (?:COLUMN )?(" + IDENT + r") (.*)$", act)
        if m:
            col = ident(m.group(1))
            c = self.s.column(t, tname, col, where)
            if c is None:
                return
            rest = m.group(2)
            ty = re.match(r"(?i)(?:SET DATA )?TYPE (.*?)(?: USING .*| COLLATE .*)?$", rest)
            if ty:
                c["type"] = norm_type(ty.group(1))
            elif re.match(r"(?i)SET NOT NULL", rest):
                c["required"] = True
            elif re.match(r"(?i)DROP NOT NULL", rest):
                c["required"] = False
            # SET/DROP DEFAULT, SET STATISTICS и т. п. структуру для документации не меняют
            return
        if re.match(r"(?i)(ENABLE|DISABLE|OWNER|SET|RESET|CLUSTER|VALIDATE|INHERIT|NO INHERIT|REPLICA)\b", act):
            return
        warn(f"{where}: {tname}: cannot parse '{act}'")


