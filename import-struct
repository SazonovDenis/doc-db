#!/usr/bin/env python3
"""
import-struct - физическая структура БД в db-struct.yaml

    import-struct --flyway DIR [DIR ...]       SQL-миграции Flyway (V<версия>__*.sql)
    import-struct --liquibase MASTER.xml       changelog Liquibase (XML, include по порядку)
    import-struct --db DSN [--schema public]   живая база PostgreSQL через psql

    -o FILE    куда писать (по умолчанию doc/db/db-struct.yaml текущего каталога)

Результат одинаков по форме для всех источников: таблицы, колонки по порядку, тип, обязательность, первичный ключ,
ссылки (FK) и допустимые значения из CHECK (col IN (...)). Файл генерируется, руками не правится.
"""
import argparse
import re
import subprocess
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

import yaml

DEFAULT_OUT = Path("doc") / "db" / "db-struct.yaml"

# служебные таблицы инструментов миграций в документацию не попадают
SERVICE_TABLES = {"flyway_schema_history", "databasechangelog", "databasechangeloglock"}


def warn(msg):
    print(f"WARN {msg}", file=sys.stderr)


# ---------------------------------------------------------------------------
# Модель
# ---------------------------------------------------------------------------

class Schema:
    """
    Таблицы в порядке создания, колонки в физическом порядке. Имена без кавычек приводятся к нижнему регистру,
    как это делает PostgreSQL. Ограничения хранятся по имени: DROP CONSTRAINT снимает именно то, что объявлено.
    """

    def __init__(self):
        self.tables = {}

    def table(self, name, where):
        t = self.tables.get(name)
        if t is None:
            warn(f"{where}: unknown table {name}")
        return t

    def column(self, t, tname, col, where):
        c = t["columns"].get(col)
        if c is None:
            warn(f"{where}: unknown column {tname}.{col}")
        return c

    def create(self, name):
        self.tables[name] = {"columns": {}, "pk": [], "constraints": {}}
        return self.tables[name]

    def drop(self, name):
        self.tables.pop(name, None)
        for t in self.tables.values():
            for cname, con in list(t["constraints"].items()):
                if con["kind"] == "fk" and con["ref"] == name:
                    del t["constraints"][cname]

    def rename_table(self, old, new):
        self.tables = {(new if k == old else k): v for k, v in self.tables.items()}
        for t in self.tables.values():
            for con in t["constraints"].values():
                if con["kind"] == "fk" and con["ref"] == old:
                    con["ref"] = new

    @staticmethod
    def rename_column(t, old, new):
        t["columns"] = {(new if k == old else k): v for k, v in t["columns"].items()}
        t["pk"] = [new if c == old else c for c in t["pk"]]
        for con in t["constraints"].values():
            if con.get("column") == old:
                con["column"] = new

    @staticmethod
    def drop_column(t, col):
        t["columns"].pop(col, None)
        if col in t["pk"]:
            t["pk"] = []
        for cname, con in list(t["constraints"].items()):
            if con.get("column") == col:
                del t["constraints"][cname]

    def to_yaml_data(self):
        out = {}
        for tname in sorted(self.tables):
            t = self.tables[tname]
            refs, values = {}, {}
            for con in t["constraints"].values():
                if con["kind"] == "fk":
                    refs[con["column"]] = con["ref"]
                elif con["kind"] == "values":
                    values[con["column"]] = con["values"]
            cols = {}
            for cname, c in t["columns"].items():
                d = {"type": c["type"]}
                if c["required"] or cname in t["pk"]:
                    d["required"] = True
                if cname in refs:
                    d["references"] = refs[cname]
                if cname in values:
                    d["values"] = values[cname]
                cols[cname] = d
            entry = {}
            if t["pk"]:
                entry["primary_key"] = list(t["pk"])
            entry["columns"] = cols
            out[tname] = entry
        return out


